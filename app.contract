// A circuit's card on the menu: its real layout, with a dot lapping it when picked.
component TrackCard
  props
    n: number
    picked: bool
  view
    column gap=6 align-items="center"
      column align-items="center" border-radius=12 overflow="hidden" background-color=(picked ? "#2f5a26" : "#24401f")
        svg width=132 height=88 viewBox="0 0 120 80" aria-hidden=true
          path d=trackPath(n) fill="none" stroke=trackEdge(n) stroke-width=9 stroke-linejoin="round"
          path d=trackPath(n) fill="none" stroke=trackStripe(n) stroke-width=9 stroke-linejoin="round" stroke-dasharray="2.5 2.5"
          path d=trackPath(n) fill="none" stroke=trackSurface(n) stroke-width=6.5 stroke-linejoin="round"
          path d=trackPath(n) fill="none" stroke="#fbf6e966" stroke-width=0.6 stroke-dasharray="2 2"
          g transform=trackStart(n)
            rect x=-1.6 y=-3.3 width=3.2 height=6.6 fill="#fbf6e9"
            rect x=-1.6 y=-3.3 width=1.6 height=1.65 fill="#22252b"
            rect x=0 y=-1.65 width=1.6 height=1.65 fill="#22252b"
            rect x=-1.6 y=0 width=1.6 height=1.65 fill="#22252b"
            rect x=0 y=1.65 width=1.6 height=1.65 fill="#22252b"
          if picked
            path d=trackPath(n) fill="none" stroke="#f2c230" stroke-width=3.2 stroke-linecap="round" pathLength=100 stroke-dasharray="5 95" animation="chase 2.4s linear infinite"
      text trackName(n) font-size=17 font-weight=900 color=(picked ? "#22252b" : "#fbf6e9")
      text trackBlurb(n) font-size=12 color=(picked ? "#3b3a2a" : "#c9d6b8")
      row gap=4 align-items="center"
        for k in [1, 2, 3] key=k
          svg width=13 height=13 viewBox="0 0 14 14" aria-hidden=true
            circle cx=7 cy=7 r=6 fill=(k <= trackLevel(n) ? "#22252b" : (picked ? "#22252b33" : "#fbf6e922")) stroke=(picked ? "#22252b" : "#fbf6e966") stroke-width=1
            circle cx=7 cy=7 r=2.4 fill=(k <= trackLevel(n) ? "#c9c9c9" : "none")
        text levelName(trackLevel(n)) font-size=10 font-weight=900 letter-spacing=1 color=(picked ? "#22252b" : "#c9d6b8")

// A mouse with its left or right button lit: how to drive.
component Mouse
  props
    right: bool
  view
    svg width=24 height=32 viewBox="0 0 24 32" aria-hidden=true
      rect x=1.5 y=1.5 width=21 height=29 rx=10.5 fill="#fbf6e9" stroke="#22252b" stroke-width=1.5
      path d=(right ? "M 12 1.5 A 10.5 10.5 0 0 1 22.5 12 L 22.5 13 L 12 13 Z" : "M 12 1.5 A 10.5 10.5 0 0 0 1.5 12 L 1.5 13 L 12 13 Z") fill=(right ? "#3fae5a" : "#d83a2e")
      line x1=12 y1=1.5 x2=12 y2=13 stroke="#22252b" stroke-width=1.5
      line x1=1.5 y1=13 x2=22.5 y2=13 stroke="#22252b" stroke-width=1.5

// A pedal's hint: which mouse button drives it.
component Pedal
  props
    right: bool
  view
    row gap=8 align-items="center" padding-top=6 padding-bottom=6 padding-left=8 padding-right=12 border-radius=12 background-color="#14201be6"
      Mouse(right=right)
      column
        text (right ? "RIGHT CLICK" : "LEFT CLICK") font-size=10 font-weight=800 letter-spacing=1 color="#c9d6b8"
        text (right ? "GAS" : "BRAKE") font-size=15 font-weight=900 color=(right ? "#a6e8b4" : "#ff8a7a")
