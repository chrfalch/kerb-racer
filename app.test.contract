// The menus and HUD on a host: `bun exact.mjs test web` (also macos, ios).
// Gameplay is tested hostless in logic/tests: `bun exact.mjs test-rust`.
test "Pick a track, race, and pause"
  expect tree has "play"
  tap "track-1"
  tap "play"
  expect tree has "world"
  expect tree has "start"
  tap "start"
  expect tree has "countdown"
  clock +4000
  expect text "hud-lap" == "1/3"
  expect tree has "radar"
  expect tree has "radar-ahead"
  tap "pause"
  expect tree has "restart"

test "Sound wakes on a tap, mutes, and stays muted in the race"
  expect state awake == false
  tap "sound"
  expect state awake == true
  expect state muted == false
  tap "sound"
  expect state muted == true
  tap "play"
  tap "start"
  tap "sound"
  expect state muted == false

test "The track carousel steps and wraps"
  expect state track == 0
  tap "track-next"
  expect state track == 1
  tap "track-prev"
  tap "track-prev"
  expect state track == 4
  tap "track-2"
  expect state track == 2
